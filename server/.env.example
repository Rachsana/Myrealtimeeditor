PORT=5000
MONGO_URI=mongodb+srv://your_username:your_password@cluster0.mongodb.net/collabdoc
JWT_SECRET=your_super_secret_key_here
CLIENT_URL=http://localhost:5173

# Optional — enables Socket.IO Redis adapter for multi-instance scaling.
# Leave blank/unset for local dev or single-instance deployment.
REDIS_URL=

# Optional — enables AI-generated "summarize changes" using OpenAI.
# Leave blank/unset and the app falls back to a heuristic text-diff summary
# (no external API calls, no cost, feature still works end-to-end).
OPENAI_API_KEY=
